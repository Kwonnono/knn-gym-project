datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  goal        Goal?
  dietLogs    DietLog[]
  workoutLogs WorkoutLog[]
}

model Goal {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  heightCm       Float
  weightKg       Float
  age            Int
  sex            String
  activityLevel  String
  goalType       String
  bmr            Int
  tdee           Int
  targetCalories Int
  targetProteinG Int
  targetCarbG    Int
  targetFatG     Int
  updatedAt      DateTime @updatedAt
}

model DietLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime @default(now())
  mealName  String
  calories  Int
  proteinG  Int
  carbG     Int
  fatG      Int
  createdAt DateTime @default(now())
}

model WorkoutLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime @default(now())
  exercise  String
  sets      Int
  reps      Int
  weightKg  Float
  createdAt DateTime @default(now())
}
